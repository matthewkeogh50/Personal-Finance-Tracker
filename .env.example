# Copy to .env and fill in. .env is ignored by git and is not copied into the Docker image.

# Access key of the IAM user the app runs as (see README for the minimal policy).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region the table lives in, e.g. eu-central-2 (Zurich) or eu-central-1 (Frankfurt).
AWS_REGION=eu-central-2
DYNAMODB_TABLE=household-finance

# Optional
API_KEY=
